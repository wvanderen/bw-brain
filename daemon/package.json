{
  "name": "bw-brain-daemon",
  "version": "0.0.0",
  "private": true,
  "description": "bw-brain local-first Bitwig intelligence layer — daemon/CLI/normalization runtime (Phase 1 kept scaffolding, D-05/D-06).",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "bw-brain": "./src/cli/bw-brain.ts",
    "bw-focus": "./src/cli/bw-brain.ts",
    "bw-project": "./src/cli/bw-brain.ts",
    "bw-midi": "./src/cli/bw-brain.ts",
    "bw-device": "./src/cli/bw-brain.ts",
    "bw-diff": "./src/cli/bw-brain.ts",
    "bw-arrange": "./src/cli/bw-brain.ts",
    "bw-automation": "./src/cli/bw-brain.ts",
    "bw-edit": "./src/cli/bw-brain.ts"
  },
  "scripts": {
    "gen:types": "node ../scripts/gen-types.mjs",
    "start": "tsx src/runtime/boot.ts",
    "dev": "tsx src/runtime/boot.ts",
    "test": "vitest run",
    "test:property": "vitest run --testNamePattern property",
    "check:capabilities": "node ../scripts/check-capabilities-doc.mjs",
    "check:bridge-artifact": "node ../scripts/check-bridge-artifact.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "tonal": "6.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "fast-check": "4.8.0",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.22.4",
    "typescript": "^5.7",
    "vitest": "4.1.9"
  }
}
